{
  "$defs": {
    "ACME": {
      "additionalProperties": false,
      "description": "Email doubles as the admin login when none is given.",
      "properties": {
        "directoryUrl": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "AdminSpec": {
      "additionalProperties": false,
      "description": "Only the address: the password is a credential and is generated into spec.secrets.",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "BackupDestination": {
      "additionalProperties": false,
      "description": "All-or-nothing: with bucket, accessKey or secretKey missing the control plane ignores the block.",
      "properties": {
        "accessKey": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "databasePath": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "useSSL": {
          "type": "boolean"
        },
        "volumePath": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "BackupEncryption": {
      "additionalProperties": false,
      "description": "Never set the passphrase to the master key; includeIdentity seals the master key in for fresh-hardware restores.",
      "properties": {
        "encrypt": {
          "type": "boolean"
        },
        "includeIdentity": {
          "type": "boolean"
        },
        "passphrase": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "BackupRetention": {
      "additionalProperties": false,
      "description": "BackupRetention caps whole recovery points. Zero is unbounded.",
      "properties": {
        "days": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "BackupSpec": {
      "additionalProperties": false,
      "description": "Stating any field pins the console's corresponding field.",
      "properties": {
        "destination": {
          "$ref": "#/$defs/BackupDestination"
        },
        "encryption": {
          "$ref": "#/$defs/BackupEncryption"
        },
        "includeTenantData": {
          "type": "boolean"
        },
        "retention": {
          "$ref": "#/$defs/BackupRetention"
        },
        "schedule": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "DNSSpec": {
      "additionalProperties": false,
      "description": "DNSSpec paces the managed-DNS re-assert sweep.",
      "properties": {
        "reconcileMinutes": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocumentMeta": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Endpoints": {
      "additionalProperties": false,
      "description": "Control is separate from Web because a private-network node may reach the control plane at another address.",
      "properties": {
        "control": {
          "type": "string"
        },
        "web": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ExternalSpec": {
      "additionalProperties": false,
      "description": "Setting it here pins it; leave it empty to manage it from Clusters.",
      "properties": {
        "baseDomain": {
          "type": "string"
        },
        "certProvider": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "GatewaySpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "string"
        },
        "configSha": {
          "description": "Written by Miabi only: the digest of the default config, which keeps a customized goma.yml from being overwritten.",
          "type": "string"
        },
        "countryHeader": {
          "description": "Needs a GeoIP database beside goma.yml; without one the header is never set.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "image": {
          "type": "string"
        },
        "trustedProxies": {
          "description": "Only connections from these may set the client IP via forwarded headers; unset when facing the internet directly.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "HostPortsSpec": {
      "additionalProperties": false,
      "description": "HostPortsSpec bounds the host ports an application may ask to publish.",
      "properties": {
        "max": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ImageSpec": {
      "additionalProperties": false,
      "description": "ImageSpec pins a component that has nothing to configure but the image it runs.",
      "properties": {
        "image": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "LicenseSpec": {
      "additionalProperties": false,
      "description": "Installed only when the database holds none: a console-added license takes precedence.",
      "properties": {
        "file": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "properties": {
        "ipv6": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "subnet": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "subnet"
      ],
      "type": "object"
    },
    "NetworkingSpec": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "$ref": "#/$defs/DNSSpec"
        },
        "external": {
          "$ref": "#/$defs/ExternalSpec"
        },
        "hostPorts": {
          "$ref": "#/$defs/HostPortsSpec"
        },
        "internal": {
          "$ref": "#/$defs/NetworkConfig"
        },
        "pool": {
          "$ref": "#/$defs/PoolSpec"
        },
        "proxy": {
          "$ref": "#/$defs/NetworkConfig"
        }
      },
      "type": "object"
    },
    "PoolSpec": {
      "additionalProperties": false,
      "description": "Explicit IPAM so Docker's small default pools cannot exhaust; must not overlap the proxy network, LAN or VPN.",
      "properties": {
        "cidr": {
          "type": "string"
        },
        "ipv6UlaPrefix": {
          "type": "string"
        },
        "subnetPrefix": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RegistrySpec": {
      "additionalProperties": false,
      "description": "The host anchors every recorded image ref and decides workspace ownership, hence read-only in the console.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "storage": {
          "enum": [
            "filesystem",
            "s3"
          ],
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "SecretsSpec": {
      "additionalProperties": false,
      "description": "Plaintext, but the file is 0600 and anyone who can read it already holds the Docker socket.",
      "properties": {
        "adminPassword": {
          "type": "string"
        },
        "dbPassword": {
          "type": "string"
        },
        "encryptionKey": {
          "type": "string"
        },
        "gomaConfigEncryptionKey": {
          "description": "Safe to lose: the gateway config is re-rendered from the database on every sync.",
          "type": "string"
        },
        "jwtSecret": {
          "type": "string"
        },
        "redisPassword": {
          "type": "string"
        },
        "registryPlatformToken": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ServerSpec": {
      "additionalProperties": false,
      "properties": {
        "dockerGid": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "hostProc": {
          "description": "HostProc is a pointer because absent must mean on.",
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "trustedProxies": {
          "description": "Defaults to the private network, the only one the gateway reaches it on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Spec": {
      "additionalProperties": false,
      "description": "Pointers because an emitted env var locks the field in the UI, so \"unset\" and \"zero\" must differ.",
      "properties": {
        "acme": {
          "$ref": "#/$defs/ACME"
        },
        "admin": {
          "$ref": "#/$defs/AdminSpec"
        },
        "backup": {
          "$ref": "#/$defs/BackupSpec"
        },
        "cache": {
          "$ref": "#/$defs/ImageSpec"
        },
        "database": {
          "$ref": "#/$defs/ImageSpec"
        },
        "domain": {
          "type": "string"
        },
        "endpoints": {
          "$ref": "#/$defs/Endpoints"
        },
        "gateway": {
          "$ref": "#/$defs/GatewaySpec"
        },
        "license": {
          "$ref": "#/$defs/LicenseSpec"
        },
        "networking": {
          "$ref": "#/$defs/NetworkingSpec"
        },
        "registry": {
          "$ref": "#/$defs/RegistrySpec"
        },
        "runnerImage": {
          "type": "string"
        },
        "secrets": {
          "$ref": "#/$defs/SecretsSpec"
        },
        "server": {
          "$ref": "#/$defs/ServerSpec"
        }
      },
      "required": [
        "domain"
      ],
      "type": "object"
    }
  },
  "$id": "https://docs.miabi.io/schema/install.miabi.io-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Miabi install: the desired state of the stack on one host.",
  "properties": {
    "apiVersion": {
      "const": "install.miabi.io/v1"
    },
    "kind": {
      "enum": [
        "ControlPlane"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/DocumentMeta"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "title": "ControlPlane",
  "type": "object"
}
