# Miabi — full-featured single-node Compose stack. Copy to .env and edit.
#
# This file is the ONLY place the stack is configured. The compose files declare
# no environment of their own — they hand this whole file to the containers — so
# every setting below reaches Miabi and takes effect on the next `up`.
#
# It is the complete reference (the same keys as the repo-root .env.example),
# with the values this stack needs already filled in. Fill in the REQUIRED ones,
# leave the rest alone unless you know you want them.
#
# Generate strong secrets:
#   openssl rand -hex 32
# Docker socket group (so the image can reach the daemon):
#   echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env

# =============================================================================
# Compose-only settings (read by the compose files and goma.yml, not by Miabi)
# =============================================================================
# REQUIRED. Panel domain. Goma issues its TLS certificate and routes it to Miabi.
MIABI_DOMAIN=miabi.example.com
# Host docker group id (see the command above). 999 is a common default.
DOCKER_GID=999
# Control-plane image to run.
MIABI_IMAGE=miabi/miabi:latest

# =============================================================================
# Stack wiring — points Miabi at the other services in this compose file.
# Change these only if you rename a service or the network.
# =============================================================================
# MUST stay `production`. On `dev` (the built-in default) Miabi permits insecure
# defaults and a wildcard CORS origin — never run a reachable install that way.
MIABI_ENV=production
MIABI_PORT=9000
MIABI_DEV_MODE=false
# Browser origins allowed to call the API. Left unset it follows MIABI_WEB_URL,
# which is what you want; production refuses "*".
# MIABI_CORS_ORIGINS=

# --- Security ----------------------------------------------------------------
# REQUIRED. Blank on purpose — and a blank secret does NOT stop `docker compose
# up`: the container starts, fails config validation and restarts in a loop. If a
# fresh install is crash-looping, check these first (`docker compose logs miabi`).
MIABI_JWT_SECRET=
# Master key (KEK). It wraps each workspace's own data-encryption key (DEK)
# rather than encrypting secrets directly; per-workspace DEKs encrypt the data.
# Keep it safe and backed up — losing it makes every workspace key unrecoverable.
MIABI_ENCRYPTION_KEY=
# Per-workspace key auto-rotation (off by default). When on, a workspace's key is
# rotated — re-encrypting its secrets — once its active key is older than
# MIABI_KEY_ROTATE_MONTHS. Admins can always rotate on demand from the workspace
# admin page regardless of this toggle.
MIABI_KEY_AUTO_ROTATE=false
MIABI_KEY_ROTATE_MONTHS=6

# Initial platform admin, seeded on first boot (owns the Platform System
# workspace). Ignored once any user exists. REQUIRED: set the password.
MIABI_ADMIN_EMAIL=admin@example.com
MIABI_ADMIN_PASSWORD=

# --- Database (the miabi-postgres service) -----------------------------------
# REQUIRED: MIABI_DB_PASSWORD. It also initializes the Postgres container, so
# `docker compose up` aborts outright if it is empty.
MIABI_DB_HOST=miabi-postgres
MIABI_DB_PORT=5432
MIABI_DB_USER=miabi
MIABI_DB_PASSWORD=
MIABI_DB_NAME=miabi
# The database is only reachable on the internal compose network.
MIABI_DB_SSL_MODE=disable
# MIABI_DB_URL=postgres://user:pass@host:5432/db?sslmode=disable

# --- Redis (cache + asynq queue; the miabi-redis service) --------------------
# REQUIRED: MIABI_REDIS_PASSWORD. It also starts the Redis container, so an empty
# value aborts `docker compose up`.
MIABI_REDIS_ADDR=miabi-redis:6379
MIABI_REDIS_PASSWORD=
# Redis database index. Must match Goma Gateway's GOMA_REDIS_DB for Workspace
# Analytics to work (Goma writes the event stream; Miabi reads it).
MIABI_REDIS_DB=0

# --- Worker ------------------------------------------------------------------
# The worker runs embedded in the panel by default; uncomment the miabi-worker
# service in compose.yaml to scale it out.
MIABI_WORKER_CONCURRENCY=10
MIABI_WORKER_MAX_RETRIES=5

# --- Log store ---------------------------------------------------------------
# Deploy, pipeline, job, and backup logs are externalized out of Postgres into
# the filesystem backend once a run is terminal, keeping only a bounded tail in
# the DB. MIABI_LOG_DIR is the miabi-logs volume in compose.yaml — if you enable
# the miabi-worker service it mounts the SAME volume, so the panel can read the
# logs the worker writes. Set MIABI_LOG_BACKEND=off to keep only the DB tail.
# MIABI_LOG_BACKEND=filesystem        # filesystem | off
# MIABI_LOG_DIR=/var/lib/miabi/logs
# MIABI_LOG_RETENTION_DAYS=30         # 0 = keep forever
# MIABI_LOG_MAX_BYTES=33554432        # per-log cap (32 MiB); middle-truncated past it
# MIABI_LOG_TAIL_BYTES=16384          # bounded tail kept in the DB (16 KiB)
# MIABI_LOG_COMPRESSION=gzip          # gzip | none

# --- Container security profile ----------------------------------------------
# OpenShift-style "run as non-root". When a workspace's plan selects the
# "restricted" profile — or MIABI_FORCE_NON_ROOT_USER forces it globally —
# application and job containers run as MIABI_RESTRICTED_UID:0 with
# no-new-privileges and NET_RAW dropped, instead of the image's default user.
# RESTRICTED_UID is the platform non-root UID (GID is always 0).
# SECURITY_INIT_IMAGE is the tiny image used to chown a restricted app's managed
# volumes to that UID so it can still write.
MIABI_RESTRICTED_UID=100000
MIABI_FORCE_NON_ROOT_USER=false
MIABI_SECURITY_INIT_IMAGE=busybox:latest

# --- Docs & metrics ----------------------------------------------------------
MIABI_OPENAPI_DOCS=true
MIABI_METRICS_ENABLED=true

# =============================================================================
# Public URLs — how browsers, nodes and runners reach this control plane
# =============================================================================
# REQUIRED. Public panel URL; also the CORS allowlist (production rejects "*").
MIABI_WEB_URL=https://miabi.example.com
MIABI_API_URL=https://miabi.example.com
# The base URL edge-gateway nodes and runners call back on (must be reachable
# FROM them). Same value as the panel URL on a single-node stack — keep in step.
MIABI_CONTROL_URL=https://miabi.example.com

# --- Platform notification email (SMTP) --------------------------------------
# When set, Miabi sends its own emails — password resets, workspace invitations,
# and new-user welcomes — via this server. Leave HOST/FROM empty to disable
# (those emails are then silently skipped). MIABI_APP_NAME is the product name
# shown in the emails; action links are built on MIABI_WEB_URL.
# MIABI_SMTP_ENCRYPTION is one of: none, starttls, ssl.
MIABI_APP_NAME=Miabi
MIABI_SMTP_HOST=
MIABI_SMTP_PORT=587
MIABI_SMTP_USERNAME=
MIABI_SMTP_PASSWORD=
MIABI_SMTP_FROM=
MIABI_SMTP_ENCRYPTION=starttls

# =============================================================================
# Gateway & networking
# =============================================================================
# Miabi drives Goma purely through its watched file-provider directory — it
# writes route/middleware files there and Goma hot-reloads them, so there is no
# API endpoint or token to configure. This path is the gateway-providers volume
# both containers mount; changing it breaks routing unless you change the mount.
MIABI_GOMA_PROVIDER_DIR=/etc/goma/providers
# Shared passphrase that makes Goma encrypt sensitive parts of its config
# (middleware rules and inline TLS certificate/key material) at rest. When set,
# Miabi injects the same value into every edge-gateway node it deploys and it
# must also be set on the local Goma so they match. Empty disables it.
GOMA_CONFIG_ENCRYPTION_KEY=
# Shared Docker network the gateway and every app container join so the proxy can
# reach app backends. This is the `miabi` network in compose.yaml.
MIABI_PROXY_NETWORK=miabi
# Managed network subnet pool. Miabi carves a unique subnet out of this CIDR for
# every Docker network it creates (workspace/stack/overlay) and passes it as
# explicit IPAM, instead of Docker's small built-in default-address-pools (which
# exhaust with "all predefined address pools have been fully subnetted"). The
# default base avoids common Kubernetes CNI, Docker, and LAN/VPN/Tailscale
# ranges; a /12 split into /24s yields 4096 networks. Pick a base that does not
# overlap your own host/LAN/VPN ranges.
MIABI_NETWORK_POOL_CIDR=10.64.0.0/12
MIABI_NETWORK_SUBNET_PREFIX=24
# Cadence (minutes) of the managed-DNS reconcile sweep, which re-asserts the
# records Miabi created via connected DNS providers and refreshes their status.
MIABI_DNS_RECONCILE_MINUTES=30

# --- One-click public app URLs (wildcard domain) -----------------------------
# Apps are published under this base domain — point *.apps.example.com at this
# host. PROVIDER is the Goma certManager provider used for those certificates
# ("" = the gateway default). When set, these override the admin Settings UI on
# boot; leave empty to manage them from the UI instead.
MIABI_EXTERNAL_BASE_DOMAIN=apps.example.com
MIABI_EXTERNAL_BASE_PROVIDER=

# --- Certificates ------------------------------------------------------------
# Goma image deployed on edge-gateway nodes, and the ACME contact email it uses.
# MIABI_ACME_EMAIL is also the contact for Miabi-issued managed (DNS-01) certs.
MIABI_NODE_GATEWAY_IMAGE=jkaninda/goma-gateway:latest
MIABI_ACME_EMAIL=admin@example.com
# ACME CA directory — empty = Let's Encrypt production; set the LE staging
# directory for testing so issuance never burns prod rate limits.
# CERT_RENEW_DAYS = renew window before expiry.
MIABI_ACME_DIRECTORY_URL=
MIABI_CERT_RENEW_DAYS=30

# =============================================================================
# Built-in container registry (git-source builds push here)
# =============================================================================
# Enabled in this stack: git-source app deploys and pipeline builds need it — the
# runner builds the image and pushes it here for the node to pull. The platform
# token is derived from the encryption key, so no separate secret is needed.
#
# NOTE: the built-in registry requires the Goma gateway (compose.yaml). On the
# compose.traefik.yaml variant set ENABLED=false and use an external registry.
#
# ENABLED, HOST and all STORAGE/S3 values are set HERE ONLY: the admin Settings
# UI shows them read-only, and a change takes a restart.
#   HOST         docker login target; defaults to registry.<EXTERNAL_BASE_DOMAIN>.
#   STORAGE      filesystem | s3   (blank = filesystem)
#   IMAGE        override the registry image (also settable via the image catalog)
#   AUTH_URL     address the gateway's forwardAuth calls to reach this control
#                plane; falls back to MIABI_CONTROL_URL.
#   PLATFORM_TOKEN  pin the push/pull secret instead of deriving it (rarely needed).
MIABI_REGISTRY_ENABLED=true
MIABI_REGISTRY_HOST=
MIABI_REGISTRY_STORAGE=filesystem
MIABI_REGISTRY_IMAGE=registry:3
MIABI_REGISTRY_AUTH_URL=http://miabi:9000
MIABI_REGISTRY_PLATFORM_TOKEN=
# S3/MinIO storage (Enterprise; STORAGE=s3 needs the registry_s3 entitlement and
# a BUCKET, or the registry refuses to start). FORCE_PATH_STYLE is MinIO-only.
MIABI_REGISTRY_S3_ENDPOINT=
MIABI_REGISTRY_S3_BUCKET=
MIABI_REGISTRY_S3_REGION=
MIABI_REGISTRY_S3_ACCESS_KEY=
MIABI_REGISTRY_S3_SECRET_KEY=
MIABI_REGISTRY_S3_FORCE_PATH_STYLE=false

# =============================================================================
# Licensing & enforcement
# =============================================================================
# Enterprise license (unlocks paid features; community runs without one).
# Provide the signed license as a file path or inline; PUBLIC_KEY verifies it.
# A LICENSE_FILE path must be mounted into the container.
MIABI_LICENSE_PUBLIC_KEY=
MIABI_LICENSE_FILE=

# PLAN_ENFORCEMENT applies per-workspace plan quotas; SECURITY_ENFORCEMENT guards
# managed containers from admin stop/remove and similar break-glass actions
# (disable only deliberately).
MIABI_PLAN_ENFORCEMENT=false
MIABI_SECURITY_ENFORCEMENT=true

# =============================================================================
# Builds & runners
# =============================================================================
# Source builds (Git apps) run on a runner, not on the node. This is the hard
# per-build deadline the runner dispatcher enforces (0 = none).
MIABI_BUILD_TIMEOUT_MINUTES=30
# Runners are dedicated build/pipeline machines that keep build load off the app
# hosting nodes. Every build runs on a registered runner — there is no on-node or
# in-process fallback. Add one from Settings → Runners; runners dial OUT to the
# panel, so they can run on this host or anywhere else.
# WAIT_TIMEOUT_MINUTES bounds how long a build waits for an available runner
# before failing; until then the run stays pending and is re-checked.
# JOB_API_TOKEN_ENABLED injects the scoped MIABI_JOB_TOKEN callback credential
# into runner jobs (registry credentials are injected regardless).
MIABI_RUNNER_WAIT_TIMEOUT_MINUTES=30
MIABI_JOB_API_TOKEN_ENABLED=true
# The miabi-runner image shown in the runner enrollment command (docker run …).
MIABI_RUNNER_IMAGE=miabi/runner:latest

# =============================================================================
# Ports, forwards & metrics
# =============================================================================
# Host port bindings: the inclusive range apps may request for host-published
# ports. Keep MIN above privileged ports unless you intend otherwise.
MIABI_HOST_PORT_MIN=1024
MIABI_HOST_PORT_MAX=65535

# On-demand database port-forwards (the socat relay). BIND_ADDR is where the
# forward listens on the node (127.0.0.1 = local only); ADVERTISE_HOST is the
# host shown to the user; TTL bounds a session; RELAY_IMAGE is the socat image.
MIABI_FORWARD_BIND_ADDR=127.0.0.1
MIABI_FORWARD_ADVERTISE_HOST=
MIABI_FORWARD_TTL_MINUTES=30
MIABI_FORWARD_RELAY_IMAGE=alpine/socat:latest

# Metrics retention + scrape cadence for the built-in container metrics.
MIABI_METRICS_RETENTION_HOURS=24
MIABI_METRICS_SCRAPE_SECONDS=60

# =============================================================================
# Workspace Analytics (HTTP traffic / performance / web)
# =============================================================================
# Rolls up Goma Gateway's per-request event stream into minute buckets. Goma must
# have GOMA_ANALYTICS_ENABLED=true and write to the same Redis DB (MIABI_REDIS_DB)
# — compose.yaml sets both on the gateway service.
#
# REQUIRES GOMA. The dashboards have no other source: requests never pass through
# the control plane, so without Goma's event stream every panel — Traffic,
# Performance, Web Analytics, and the live-visitor count — stays empty. On the
# compose.traefik.yaml variant set this to false so no consumer runs waiting on a
# stream nothing writes.
MIABI_ANALYTICS_ENABLED=true
# Redis stream Goma publishes request events to (must match GOMA_ANALYTICS_STREAM).
MIABI_ANALYTICS_STREAM=goma:analytics
# How often (seconds) the consumer persists closed minute buckets.
MIABI_ANALYTICS_FLUSH_SECONDS=15
# Rollup retention (days). Community is capped at 7; extended retention is Enterprise.
MIABI_ANALYTICS_RETENTION_DAYS=90

# GeoIP: powers the "requests by country" panels + the geo-block middleware.
# Miabi downloads nothing — every GeoIP database carries license terms only you
# can accept for your deployment (MaxMind's GeoLite2 forbids redistribution;
# DB-IP Lite and IP2Location LITE are free but require credit wherever the data
# shows). So bring your own: put any MaxMind-format .mmdb at
# /etc/miabi/country.mmdb and restart the gateway. Without it the country panels
# stay empty. See docs/operations/analytics for the options.
# MIABI_GEOIP=off ignores the file even when it is there.
MIABI_GEOIP=on

# =============================================================================
# Misc
# =============================================================================
# Marketplace template catalog source. A server base URL fetches /v1/export; a
# .json URL is fetched as-is. Empty disables syncing (embedded templates only).
# Pointing this at your own catalog is an Enterprise feature (private_registry);
# unlicensed installs fall back to the official catalog.
MIABI_MARKETPLACE_URL=https://marketplace.miabi.io

# Account deletion grace window (days) before a scheduled account is purged.
MIABI_DELETION_GRACE_DAYS=7

# Max size (MB) of a backup artifact accepted for restore.
MIABI_RESTORE_MAX_MB=1024

# Allow outbound webhooks to private/loopback targets (SSRF guard). Keep false in
# production unless you trust every configured webhook URL.
MIABI_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Host /proc mount, for node host metrics (the /proc:/host/proc:ro bind).
MIABI_HOST_PROC=/host/proc

# Permit booting a binary older than the version recorded by the last run.
MIABI_ALLOW_DOWNGRADE=false
